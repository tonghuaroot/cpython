  <!ELEMENT ol (li+)>
  <!ELEMENT li (#PCDATA)>
  <!ELEMENT em (#PCDATA)>
  <!ELEMENT strong (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
  <!ELEMENT warn (#PCDATA)>
  <!ELEMENT tip (#PCDATA)>
]>
<doc><p>hi <em>there</em></p><ul><li>x</li></ul></doc>
